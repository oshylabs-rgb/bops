{
  "appId": "eu.oshylabs.oshyops",
  "productName": "Oshy Ops",
  "copyright": "Based on Bops by Organic Intelligence, Inc. (FSL-1.1-ALv2). Windows port by Oshylabs Ltd.",
  "publish": null,
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "desktop/**/*",
    "!desktop/repo.json",
    "!node_modules/**/*"
  ],
  "extraResources": [
    { "from": ".next/standalone", "to": "server", "filter": ["**/*", "!.env*", "!.data/**"] },
    { "from": ".next/standalone/node_modules", "to": "server/node_modules" },
    { "from": ".next/static", "to": "server/.next/static" },
    { "from": "public", "to": "server/public" }
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "zip", "arch": ["x64"] }
    ],
    "icon": "desktop/oshyops.ico",
    "artifactName": "OshyOps-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Oshy Ops",
    "installerIcon": "desktop/oshyops.ico",
    "uninstallerIcon": "desktop/oshyops.ico"
  }
}
